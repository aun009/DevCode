[Unit]
Description=DevCode API Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/devcode/backend
ExecStart=/home/ubuntu/.bun/bin/bun run index.ts
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/devcode/backend/.env
# Allow enough open files for connection pooling
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
